CATALYST_INSTANCE_NAME=continuum-private
CATALYST_DATABASE_URL=postgres://continuum:change-me@postgres.internal:5432/continuum
CATALYST_REDIS_URL=redis://:change-me@redis.internal:6379/0
CATALYST_ARTIFACT_ROOT=/var/lib/catalyst-continuum/artifacts
CATALYST_RUNTIME_PROVIDER=docker
CATALYST_DEFAULT_SANDBOX_PROFILE=restricted

CATALYST_GITHUB_APP_ID=
CATALYST_GITHUB_APP_INSTALLATION_ID=
CATALYST_GITHUB_APP_WEBHOOK_SECRET=
CATALYST_GITHUB_APP_PRIVATE_KEY_PATH=./secrets/github-app.pem
