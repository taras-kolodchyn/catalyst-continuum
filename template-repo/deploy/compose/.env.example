COMPOSE_PROJECT_NAME=catalyst-continuum-private

POSTGRES_PASSWORD=change-me
LITELLM_DATABASE_NAME=litellm
REDIS_PASSWORD=change-me
ORCHESTRATOR_PORT=8080
GRAFANA_ADMIN_PASSWORD=change-me
# Optional. Set to /app/config/repository-targets.yaml when the private compose
# stack should enforce real GitHub publication targets.
CATALYST_REPOSITORY_TARGETS_FILE=
LITELLM_DEFAULT_MODEL=
LITELLM_PORT=4000
LITELLM_MASTER_KEY=change-me
LITELLM_MACOS_NATIVE_MODEL=openai/mlx-community/Qwen2.5-Coder-3B-Instruct-4bit
LITELLM_MACOS_NATIVE_API_BASE=http://host.docker.internal:8080/v1
LITELLM_MACOS_NATIVE_API_KEY=local-mlx
LITELLM_OLLAMA_MODEL=ollama/qwen2.5-coder:7b
LITELLM_OLLAMA_API_BASE=http://host.docker.internal:11434
LITELLM_CACHE_NAMESPACE=catalyst-continuum-litellm
LITELLM_OTEL_ENABLE_EVENTS=true
LITELLM_OTEL_ENVIRONMENT_NAME=local-compose
LITELLM_OTEL_SERVICE_NAME=catalyst-continuum-litellm

CATALYST_GITHUB_APP_ID=
CATALYST_GITHUB_APP_INSTALLATION_ID=
CATALYST_GITHUB_APP_WEBHOOK_SECRET=
